# OPTIONAL. Nugagawen works without any key: places come from OpenStreetMap, bundled
# in the app, and the map uses OpenFreeMap tiles. See README.
#
# To use a key: copy this file to .env.local (git ignores it), paste the key, and
# restart the dev server.

# MapTiler map tiles and styling, instead of OpenFreeMap. Free plan: no card needed,
# non-commercial use, and the map pauses if you pass its monthly limit. A key is
# visible inside the app, so restrict it to your app in the MapTiler dashboard.
EXPO_PUBLIC_MAPTILER_KEY=

# Google ratings and photos, instead of OpenStreetMap. Google requires a billing
# account and charges beyond its free monthly allowance.
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=
