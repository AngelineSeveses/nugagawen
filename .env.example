# OPTIONAL. Nugagawen works without any key: place data comes from OpenStreetMap,
# bundled in the app (free, offline). See README.
#
# Only if you want Google ratings and photos instead: copy this file to .env.local
# (git ignores it) and paste a Google Places API (New) key. Google requires a billing
# account and charges beyond its free monthly allowance.
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=
